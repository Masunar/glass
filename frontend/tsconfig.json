{
  "include": [
    "**/*",
    "**/.server/**/*",
    "**/.client/**/*",
    ".react-router/types/**/*"
  ],
  "compilerOptions": {
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "types": ["node", "vite/client"],
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "rootDirs": [".", "./.react-router/types"],
    "baseUrl": ".",
    "ignoreDeprecations": "6.0",
    "paths": {
      "@salvon/*": ["./salvon/*"],
      "@router-types/*": ["./.react-router/types/*"],
      "@root/*": ["./app/*"],
      "@app/*": ["./app/src/*"],
      "@router/*": ["./app/src/router/*"],
      "@assets/*": ["./app/assets/*"],
      "@app-components/*": ["./app/src/routes/(app)/_components/*"],
      "@app_env": ["./env"]
    },
    "esModuleInterop": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true
  }
}
