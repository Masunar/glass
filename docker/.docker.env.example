# Image config
NGINX_IMAGE_VERSION=mainline-alpine
PHP_IMAGE_VERSION=8.5-fpm-alpine
NODE_IMAGE_VERSION=24-alpine
PMA_IMAGE_VERSION=latest

# Application config
CONTAINER_PREFIX=salvon_app
APP_FRONT_DEV_PORT=3000
APP_NGINX_PORT=8080
PMA_WEB_PORT=8081
APP_REVERB_PORT=8082

# Mariadb Config
MYSQL_IMAGE_VERSION=latest
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=project
MYSQL_USER=admin
MYSQL_PASSWORD=root

#PMA config
PMA_UPLOAD_LIMIT=1024M

# Mailpit Config
MAILPIT_UI_PORT=8025
MAILPIT_SMTP_PORT=1025
