# Larastan uczy PHPStana Eloquenta: zna kolumny z migracji, typy relacji
# i sygnatury buildera. Bez niego kazdy model potrzebowal adnotacji
# @property wylacznie po to, zeby analiza przestala krzyczec — a taka
# adnotacja potrafi klamac i nikt tego nie zauwazy, dopoki nie wywola sie
# na niej metody, ktorej tam nie ma.
includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    # Seedery i testy tez sa kodem. Analizowane bylo samo app/, wiec
    # blad w seederze wychodzil dopiero przy odpaleniu bazy.
    paths:
        - app/
        - database/
        - tests/

    level: 5

    # Bez tego Larastan nie wie, jakie kolumny maja tabele, i kazda
    # wlasciwosc modelu jest dla niego mixed — czyli przechodzi wszystko.
    # Ze sciezka czyta typy wprost z migracji.
    databaseMigrationsPath:
        - database/migrations
